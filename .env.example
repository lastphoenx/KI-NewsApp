# Database (relative path - DO NOT use absolute paths!)
DB_URL=sqlite:///app.db

# AI Provider API Keys (at least one required!)
# Get your keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Mistral: https://console.mistral.ai/
OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# MISTRAL_API_KEY=your-mistral-api-key-here

# Default AI Settings (optional - can be overridden per template/run)
DEFAULT_AI_PROVIDER=openai        # openai | anthropic | mistral
DEFAULT_AI_MODEL=gpt-4o-mini      # Model ID
DEFAULT_TEMPERATURE=0.0           # 0.0 = deterministic, 1.0 = creative
